{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oldienki/telemetry/spec/schemas/packet.schema.json",
  "title": "TelemetryPacket",
  "type": "object",
  "required": ["topic", "id", "class", "ts"],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "Event topic. The name '_session' is reserved for client keepalive probes; servers refresh the sender session but never publish '_session' events to the event bus."
    },
    "id": { "type": "string", "minLength": 1 },
    "class": { "type": "string", "minLength": 1 },
    "ts": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
